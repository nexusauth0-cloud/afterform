# ---------------------------------------------------------------------------
# AFTERFORM 001 — environment template
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public site URL used for metadata, Open Graph, sitemap and JSON-LD.
# On Vercel, this can be omitted: the app falls back to the production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Release window (ISO 8601 with an explicit offset).
# Defaults: launch 2026-11-17T00:00:00+01:00 / close 2026-11-24T23:59:59+01:00
NEXT_PUBLIC_DROP_LAUNCH_AT=2026-11-17T00:00:00+01:00
NEXT_PUBLIC_DROP_CLOSE_AT=2026-11-24T23:59:59+01:00

# Force the archive / sold-out state regardless of dates.
# Also available for preview at /?preview=soldout
NEXT_PUBLIC_FORCE_SOLD_OUT=false

# ---------------------------------------------------------------------------
# Stripe Checkout (server-only)
# Leave unset to keep the honest "Stripe not configured" boundary.
# Use a test-mode secret key while reviewing the flow.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Waitlist delivery (optional, server-only)
# If neither a webhook nor Resend is configured, /api/waitlist runs in demo
# mode and explicitly reports that the email was not stored or sent.
# ---------------------------------------------------------------------------

# Option A — forward each signup to an automation/webhook endpoint.
WAITLIST_WEBHOOK_URL=

# Option B — send a notification email through Resend.
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=
WAITLIST_TO_EMAIL=
